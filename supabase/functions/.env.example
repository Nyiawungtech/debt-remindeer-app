# Optional environment overrides; production settings are stored in encrypted Vault.
APP_URL=https://settleupapp.cloud
WORKER_SECRET=generate-a-random-worker-secret
RESEND_API_KEY=your-server-only-key
EMAIL_FROM=SettleUp <reminders@settleupapp.cloud>
VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-server-only-private-key
