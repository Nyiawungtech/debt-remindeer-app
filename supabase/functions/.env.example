# Server-only settings. Prefer encrypted Vault entries for the hosted project.
# Never commit real values or paste secret values into chat.
APP_URL=https://your-domain.example
WORKER_SECRET=generate-a-random-secret-of-at-least-32-bytes
RESEND_API_KEY=
EMAIL_FROM=Duewell <reminders@your-verified-domain.example>
# Supabase injects SUPABASE_URL and modern publishable/secret key dictionaries.
# SMS and push delivery are paused; no credentials are required for those channels.
